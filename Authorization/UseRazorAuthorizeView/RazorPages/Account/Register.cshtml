@page "/Account/Register"
@model UseRazor.RazorPages.Account.RegisterModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center" 
     style="background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);">

    <div class="card shadow-lg p-4 border-0" style="width: 450px; border-radius: 20px;">
        <div class="text-center mb-4">
            <img src="https://cdn-icons-png.flaticon.com/512/5087/5087579.png" 
                 alt="Register Icon" width="80" class="mb-2" />
            <h3 class="fw-bold text-primary">Crear Cuenta</h3>
            <p class="text-muted">Regístrate para comenzar</p>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-semibold">Correo Electrónico</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="bi bi-envelope-fill text-primary"></i>
                    </span>
                    <input asp-for="Input.Email" name="Input.Email" class="form-control" placeholder="correo@ejemplo.com" required />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label fw-semibold">Nombre de Usuario</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="bi bi-person-fill text-primary"></i>
                    </span>
                    <input asp-for="Input.Username" name="Input.Username" class="form-control" placeholder="TuNombreUsuario" required />
                </div>
                <span asp-validation-for="Input.Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="bi bi-lock-fill text-primary"></i>
                    </span>
                    <input asp-for="Input.Password" name="Input.Password" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirmar Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="bi bi-shield-lock-fill text-primary"></i>
                    </span>
                    <input asp-for="Input.ConfirmPassword" name="Input.ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                <i class="bi bi-person-plus-fill me-1"></i> Registrarse
            </button>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-3 text-center small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.ErrorMessage
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert alert-warning mt-3 text-center small">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> Por favor, revisa los datos ingresados.
                </div>
            }
        </form>

        <div class="text-center mt-3">
            <span class="text-muted small">¿Ya tienes una cuenta?</span>
            <a href="/Account/Login" class="text-decoration-none text-primary small fw-semibold">Inicia sesión</a>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
