@{
    ViewData["Title"] = "Panel de control ";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="privacy-header text-center mb-5">
                <div class="privacy-icon mb-3">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="2"/>
                        <rect x="7" y="7" width="3" height="3" fill="currentColor"/>
                        <rect x="14" y="7" width="3" height="3" fill="currentColor"/>
                        <rect x="7" y="14" width="10" height="3" fill="currentColor"/>
                    </svg>
                </div>
                <h1 class="display-4 fw-bold text-gradient">Panel de Control</h1>
                <p class="lead text-muted">Recursos Humanos.</p>
            </div>

            <div class="privacy-content">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle me-3">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </div>
                            <h3 class="mb-0">Gestión de Usuarios</h3>
                        </div>
                        <p class="text-muted mb-0">Administra usuarios registrados, roles y permisos del sistema.</p>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle me-3">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </div>
                            <h3 class="mb-0">Funciones disponibles</h3>
                        </div>
                        <p>Como administrador tienes acceso a todas las herramientas necesarias para mantener el sistema funcionando correctamente.</p>
                        <ul class="custom-list">
                            <li>Crear, editar y eliminar usuarios</li>
                            <li>Asignar y modificar roles de usuario</li>
                            <li>Monitorear actividad del sistema</li>
                            <li>Gestionar configuraciones globales</li>
                        </ul>
                    </div>
                </div>


                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle me-3">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M3 3V21H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M9 9L12 6L16 10L20 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <h3 class="mb-0">Reportes y estadísticas</h3>
                        </div>
                        <p>Accede a información detallada sobre el uso del sistema y rendimiento general.</p>
                        <ul class="custom-list">
                            <li>Usuarios activos por período</li>
                            <li>Actividad por roles y permisos</li>
                            <li>Reportes de errores del sistema</li>
                            <li>Métricas de rendimiento</li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="actions-section">
    <div class="container">
        <div class="section-header">
            <h2>Herramientas de Capital Humano</h2>
            <p>Gestión integral del talento</p>
        </div>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="action-card">
                    <div class="action-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17 21V19C17 17.9391 16.5786 16.9217 15.8284 16.1716C15.0783 15.4214 14.0609 15 13 15H5C3.93913 15 2.92172 15.4214 2.17157 16.1716C1.42143 16.9217 1 17.9391 1 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M23 21V19C22.9993 18.1137 22.7044 17.2528 22.1614 16.5523C21.6184 15.8519 20.8581 15.3516 20 15.13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M16 3.13C16.8604 3.35031 17.623 3.85071 18.1676 4.55232C18.7122 5.25392 19.0078 6.11683 19.0078 7.005C19.0078 7.89318 18.7122 8.75608 18.1676 9.45769C17.623 10.1593 16.8604 10.6597 16 10.88" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <h4>Gestión de Personal</h4>
                    <p>Directorio de empleados, organigramas y perfiles laborales</p>
                    <button class="btn btn-action">Ver Personal</button>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="action-card">
                    <div class="action-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M22 11L20 13L18 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 11L4 13L6 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <h4>Reclutamiento</h4>
                    <p>Vacantes activas, candidatos y proceso de selección</p>
                    <button class="btn btn-action">Gestionar</button>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="action-card">
                    <div class="action-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M17 5H9.5C8.57174 5 7.6815 5.36875 7.02513 6.02513C6.36875 6.6815 6 7.57174 6 8.5C6 9.42826 6.36875 10.3185 7.02513 10.9749C7.6815 11.6312 8.57174 12 9.5 12H14.5C15.4283 12 16.3185 12.3687 16.9749 13.0251C17.6312 13.6815 18 14.5717 18 15.5C18 16.4283 17.6312 17.3185 16.9749 17.9749C16.3185 18.6312 15.4283 19 14.5 19H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <h4>Nómina y Compensaciones</h4>
                    <p>Procesamiento de pagos, deducciones y beneficios</p>
                    <button class="btn btn-action">Procesar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .privacy-header .privacy-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        color: white;
        margin: 0 auto;
    }

    .icon-circle {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
    }

    .custom-list {
        list-style: none;
        padding: 0;
    }

        .custom-list li {
            padding: 0.5rem 0;
            padding-left: 2rem;
            position: relative;
        }

            .custom-list li::before {
                content: "✓";
                position: absolute;
                left: 0;
                top: 0.5rem;
                color: #667eea;
                font-weight: bold;
                width: 1.5rem;
                height: 1.5rem;
                background: rgba(102, 126, 234, 0.1);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
            }

    .contact-section {
        margin-top: 3rem;
    }

    .contact-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border-radius: 50%;
        color: #667eea;
        margin: 0 auto;
    }
</style>

