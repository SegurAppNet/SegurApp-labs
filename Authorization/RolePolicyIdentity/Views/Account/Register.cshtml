@model PoliticaDeRolesIdentity.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registrar Usuario";
    ViewData["HideNav"] = true;
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L13.09 8.26L22 9L13.09 9.74L12 16L10.91 9.74L2 9L10.91 8.26L12 2Z"
                        fill="currentColor" />
                </svg>
            </div>
            <h2 class="login-title">Crea una cuenta</h2>
            <p class="login-subtitle">Bienvenido</p>
        </div>

        <form asp-action="Register" method="post" class="login-form">


            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control login-input" placeholder="Usuario" required />
                <label asp-for="Email" class="form-label">Usuario</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
                <div class="input-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path
                            d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Password" type="password" class="form-control login-input" placeholder="Contraseña"
                    required />
                <label asp-for="Password" class="form-label">Contraseña</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
                <div class="input-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="currentColor"
                            stroke-width="2" />
                        <path
                            d="M7 11V7C7 5.67392 7.52678 4.40215 8.46447 3.46447C9.40215 2.52678 10.6739 2 12 2C13.3261 2 14.5979 2.52678 15.5355 3.46447C16.4732 4.40215 17 5.67392 17 7V11"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="ConfirmPassword" type="password" class="form-control login-input"
                    placeholder="Contraseña" required />
                <label asp-for="ConfirmPassword" class="form-label">Confirma contraseña</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                <div class="input-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="currentColor"
                            stroke-width="2" />
                        <path
                            d="M7 11V7C7 5.67392 7.52678 4.40215 8.46447 3.46447C9.40215 2.52678 10.6739 2 12 2C13.3261 2 14.5979 2.52678 15.5355 3.46447C16.4732 4.40215 17 5.67392 17 7V11"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <div class="form-floating mb-4">
                <select asp-for="Role" class="form-control login-input" required>
                    <option value="">Selecciona un rol</option>
                    @foreach (var role in PoliticaDeRolesIdentity.Services.UserRoles.GetAllRoles())
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <label asp-for="Role" class="form-label">Rol</label>
                <span asp-validation-for="Role" class="text-danger small"></span>
                <div class="input-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M17 21V19C17 17.9391 16.5786 16.9217 15.8284 16.1716C15.0783 15.4214 14.0609 15 13 15H5C3.93913 15 2.92172 15.4214 2.17157 16.1716C1.42143 16.9217 1 17.9391 1 19V21"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path
                            d="M9 11C11.2091 11 13 9.20914 13 7C13 4.79086 11.2091 3 9 3C6.79086 3 5 4.79086 5 7C5 9.20914 6.79086 11 9 11Z"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path
                            d="M23 21V19C22.9993 18.1137 22.7044 17.2528 22.1614 16.5523C21.6184 15.8519 20.8581 15.3516 20 15.13"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path
                            d="M16 3.13C16.8604 3.35031 17.623 3.85071 18.1676 4.55232C18.7122 5.25392 19.0078 6.11683 19.0078 7.005C19.0078 7.89317 18.7122 8.75608 18.1676 9.45768C17.623 10.1593 16.8604 10.6597 16 10.88"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <!-- Añadir al formulario el registro del dato del claim que creaste en la carpeta de Services
            Si se definio un claim, que varia por otro atributo, por ejemplo, el claim creado son sobre área de trabajo, y estas varian de acuerdo al rol, recuerda añadir el script que maneje esa lógica -->

            <button type="submit" class="btn btn-login w-100">
                <span class="btn-text">Crear cuenta</span>
                <div class="btn-loader d-none">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </button>
        </form>

    </div>

    <div class="login-bg-pattern"></div>
</div>

<script>
    document.querySelector('.login-form').addEventListener('submit', function () {
        const btn = document.querySelector('.btn-login');
        const btnText = btn.querySelector('.btn-text');
        const btnLoader = btn.querySelector('.btn-loader');

        btnText.classList.add('d-none');
        btnLoader.classList.remove('d-none');
        btn.disabled = true;
    });

    <!-- Aquí puedes añadir el script necesario para manejar la lógica del claim adicional según el rol seleccionado -->
</script>